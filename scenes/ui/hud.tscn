[node name="Title" type="Label" parent="GrimoireDialog/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.85, 0.5, 1)
theme_override_font_sizes/font_size = 12
text = "FATHER'S GRIMOIRE — RITUAL OF CONTAINMENT"
horizontal_alignment = 1

[node name="Body" type="Label" parent="GrimoireDialog/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.85, 1)
theme_override_font_sizes/font_size = 9
text = "1. CHALK: Press SPACE to enter Ritual Mode. Click and drag to draw a closed circular seal upon the village ground.
2. IRON NAIL: Approach the drawn circle and press F to drive the consecrated nail, anchoring the ritual.
3. THE TETHER: An ethereal bond links you to the anchor.
   - Stay within range to keep the tether STABLE.
   - Straying too far strains the bond.
   - If stretched beyond limit, it SNAPS in a concussive shockwave, leaving you stunned and the spirit free!
4. CONTAINMENT: Lure the cursed entity into the active circle. Hold the bond steady until the runes permanently seal it."
autowrap_mode = 2

[node name="ClosePrompt" type="Label" parent="GrimoireDialog/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.6, 1)
theme_override_font_sizes/font_size = 9
text = "[Press TAB or ESC to close]"
horizontal_alignment = 1

